# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Plugin runtime (never committed)
/tmp/tp-*

# Local overrides
*.local.md
*.local.json

# Design-gate canary working copies — never committed (plan workspace spec).
# A gate folder can sit in a plan folder or beside any audited document, so the
# pattern is path-agnostic; the gate also deletes the folder once it is used.
**/.canary/
